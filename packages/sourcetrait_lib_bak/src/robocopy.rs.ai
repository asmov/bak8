// this is claude's *opinion* on what the `robocopy` command does on windows

use windows_sys::Win32::{
    Storage::FileSystem::*,
    Security::*,
    System::{Ioctl::*, SystemServices::*, Threading::*},
    Foundation::*,
};
use std::os::windows::prelude::*;
use std::ptr::{null, null_mut};
use std::mem::{size_of, zeroed};

pub struct RobustCopy {
    copy_flags: u32,
    retry_count: u32,
    retry_wait_ms: u32,
}

impl RobustCopy {
    pub fn new() -> Self {
        Self {
            copy_flags: COPY_ALL,
            retry_count: 3,
            retry_wait_ms: 1000,
        }
    }

    pub fn copy_file(&self, src: &Path, dst: &Path) -> std::io::Result<()> {
        // Enable required privileges
        self.enable_privileges()?;
        
        // Retry loop for resilience
        let mut last_error = None;
        for attempt in 0..self.retry_count {
            if attempt > 0 {
                std::thread::sleep(Duration::from_millis(self.retry_wait_ms));
            }
            
            match self.copy_file_internal(src, dst) {
                Ok(()) => return Ok(()),
                Err(e) => last_error = Some(e),
            }
        }
        
        Err(last_error.unwrap())
    }

    fn copy_file_internal(&self, src: &Path, dst: &Path) -> std::io::Result<()> {
        unsafe {
            let src_wide: Vec<u16> = src.as_os_str().encode_wide().chain(Some(0)).collect();
            let dst_wide: Vec<u16> = dst.as_os_str().encode_wide().chain(Some(0)).collect();
            
            // Step 1: Use BackupRead/BackupWrite for complete data copy
            self.backup_copy(&src_wide, &dst_wide)?;
            
            // Step 2: Handle special NTFS features
            self.copy_sparse_ranges(&src_wide, &dst_wide)?;
            self.copy_reparse_point(&src_wide, &dst_wide)?;
            self.copy_compression_state(&src_wide, &dst_wide)?;
            self.copy_encryption(&src_wide, &dst_wide)?;
            self.copy_object_id(&src_wide, &dst_wide)?;
            
            // Step 3: Copy all metadata
            self.copy_security(&src_wide, &dst_wide)?;
            self.copy_timestamps(&src_wide, &dst_wide)?;
            self.copy_attributes(&src_wide, &dst_wide)?;
            
            Ok(())
        }
    }

    unsafe fn backup_copy(&self, src: *const u16, dst: *const u16) -> std::io::Result<()> {
        // Open source with backup semantics
        let src_handle = CreateFileW(
            src,
            GENERIC_READ | ACCESS_SYSTEM_SECURITY,
            FILE_SHARE_READ | FILE_SHARE_WRITE,
            null(),
            OPEN_EXISTING,
            FILE_FLAG_BACKUP_SEMANTICS | 
            FILE_FLAG_SEQUENTIAL_SCAN |
            FILE_FLAG_OPEN_REPARSE_POINT,
            0,
        );
        
        if src_handle == INVALID_HANDLE_VALUE {
            return Err(std::io::Error::last_os_error());
        }
        
        // Create destination with backup semantics
        let dst_handle = CreateFileW(
            dst,
            GENERIC_WRITE | WRITE_DAC | WRITE_OWNER | ACCESS_SYSTEM_SECURITY,
            0,
            null(),
            CREATE_ALWAYS,
            FILE_FLAG_BACKUP_SEMANTICS | 
            FILE_FLAG_SEQUENTIAL_SCAN |
            FILE_FLAG_OPEN_REPARSE_POINT,
            0,
        );
        
        if dst_handle == INVALID_HANDLE_VALUE {
            CloseHandle(src_handle);
            return Err(std::io::Error::last_os_error());
        }
        
        // Backup read/write context
        let mut src_context = null_mut();
        let mut dst_context = null_mut();
        let mut buffer = vec![0u8; 64 * 1024]; // 64KB buffer
        
        loop {
            let mut bytes_read = 0;
            let success = BackupRead(
                src_handle,
                buffer.as_mut_ptr(),
                buffer.len() as u32,
                &mut bytes_read,
                FALSE,  // Don't abort
                TRUE,   // Process security
                &mut src_context,
            );
            
            if success == 0 || bytes_read == 0 {
                break;
            }
            
            let mut bytes_written = 0;
            let mut total_written = 0;
            
            while total_written < bytes_read {
                let write_result = BackupWrite(
                    dst_handle,
                    buffer.as_ptr().add(total_written as usize),
                    bytes_read - total_written,
                    &mut bytes_written,
                    FALSE,  // Don't abort
                    TRUE,   // Process security
                    &mut dst_context,
                );
                
                if write_result == 0 {
                    BackupRead(src_handle, null_mut(), 0, &mut bytes_read, TRUE, FALSE, &mut src_context);
                    BackupWrite(dst_handle, null_mut(), 0, &mut bytes_written, TRUE, FALSE, &mut dst_context);
                    CloseHandle(src_handle);
                    CloseHandle(dst_handle);
                    return Err(std::io::Error::last_os_error());
                }
                
                total_written += bytes_written;
            }
        }
        
        // Clean up backup contexts
        BackupRead(src_handle, null_mut(), 0, &mut bytes_read, TRUE, FALSE, &mut src_context);
        BackupWrite(dst_handle, null_mut(), 0, &mut bytes_written, TRUE, FALSE, &mut dst_context);
        
        CloseHandle(src_handle);
        CloseHandle(dst_handle);
        
        Ok(())
    }

    unsafe fn copy_sparse_ranges(&self, src: *const u16, dst: *const u16) -> std::io::Result<()> {
        let src_handle = CreateFileW(src, GENERIC_READ, FILE_SHARE_READ, null(), OPEN_EXISTING, 0, 0);
        if src_handle == INVALID_HANDLE_VALUE {
            return Ok(()); // Not sparse or can't open
        }
        
        let dst_handle = CreateFileW(dst, GENERIC_WRITE, 0, null(), OPEN_EXISTING, 0, 0);
        if dst_handle == INVALID_HANDLE_VALUE {
            CloseHandle(src_handle);
            return Ok(());
        }
        
        // Check if source is sparse
        let mut file_info: BY_HANDLE_FILE_INFORMATION = zeroed();
        GetFileInformationByHandle(src_handle, &mut file_info);
        
        if (file_info.dwFileAttributes & FILE_ATTRIBUTE_SPARSE_FILE) != 0 {
            // Make destination sparse
            let mut bytes_returned = 0;
            DeviceIoControl(
                dst_handle,
                FSCTL_SET_SPARSE,
                null_mut(),
                0,
                null_mut(),
                0,
                &mut bytes_returned,
                null_mut(),
            );
            
            // Query and copy sparse ranges
            let mut query_range: FILE_ALLOCATED_RANGE_BUFFER = zeroed();
            query_range.Length = i64::MAX;
            
            let mut ranges = vec![0u8; 1024 * size_of::<FILE_ALLOCATED_RANGE_BUFFER>()];
            
            DeviceIoControl(
                src_handle,
                FSCTL_QUERY_ALLOCATED_RANGES,
                &query_range as *const _ as *const _,
                size_of::<FILE_ALLOCATED_RANGE_BUFFER>() as u32,
                ranges.as_mut_ptr() as *mut _,
                ranges.len() as u32,
                &mut bytes_returned,
                null_mut(),
            );
            
            // Copy only allocated ranges
            let range_count = bytes_returned as usize / size_of::<FILE_ALLOCATED_RANGE_BUFFER>();
            let ranges_typed = std::slice::from_raw_parts(
                ranges.as_ptr() as *const FILE_ALLOCATED_RANGE_BUFFER,
                range_count,
            );
            
            for range in ranges_typed {
                let mut buffer = vec![0u8; range.Length as usize];
                let mut offset = LARGE_INTEGER { QuadPart: range.FileOffset };
                
                SetFilePointerEx(src_handle, offset, null_mut(), FILE_BEGIN);
                SetFilePointerEx(dst_handle, offset, null_mut(), FILE_BEGIN);
                
                let mut bytes_read = 0;
                ReadFile(
                    src_handle,
                    buffer.as_mut_ptr() as *mut _,
                    buffer.len() as u32,
                    &mut bytes_read,
                    null_mut(),
                );
                
                let mut bytes_written = 0;
                WriteFile(
                    dst_handle,
                    buffer.as_ptr() as *const _,
                    bytes_read,
                    &mut bytes_written,
                    null_mut(),
                );
            }
            
            // Set final file size
            let mut file_size = LARGE_INTEGER { QuadPart: 0 };
            GetFileSizeEx(src_handle, &mut file_size);
            SetFilePointerEx(dst_handle, file_size, null_mut(), FILE_BEGIN);
            SetEndOfFile(dst_handle);
        }
        
        CloseHandle(src_handle);
        CloseHandle(dst_handle);
        Ok(())
    }

    unsafe fn copy_reparse_point(&self, src: *const u16, dst: *const u16) -> std::io::Result<()> {
        let src_handle = CreateFileW(
            src,
            GENERIC_READ,
            FILE_SHARE_READ,
            null(),
            OPEN_EXISTING,
            FILE_FLAG_OPEN_REPARSE_POINT | FILE_FLAG_BACKUP_SEMANTICS,
            0,
        );
        
        if src_handle == INVALID_HANDLE_VALUE {
            return Ok(());
        }
        
        // Check if it's a reparse point
        let mut file_info: BY_HANDLE_FILE_INFORMATION = zeroed();
        GetFileInformationByHandle(src_handle, &mut file_info);
        
        if (file_info.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) != 0 {
            let mut buffer = vec![0u8; MAXIMUM_REPARSE_DATA_BUFFER_SIZE as usize];
            let mut bytes_returned = 0;
            
            let result = DeviceIoControl(
                src_handle,
                FSCTL_GET_REPARSE_POINT,
                null_mut(),
                0,
                buffer.as_mut_ptr() as *mut _,
                buffer.len() as u32,
                &mut bytes_returned,
                null_mut(),
            );
            
            if result != 0 {
                let dst_handle = CreateFileW(
                    dst,
                    GENERIC_WRITE,
                    0,
                    null(),
                    OPEN_EXISTING,
                    FILE_FLAG_OPEN_REPARSE_POINT | FILE_FLAG_BACKUP_SEMANTICS,
                    0,
                );
                
                if dst_handle != INVALID_HANDLE_VALUE {
                    DeviceIoControl(
                        dst_handle,
                        FSCTL_SET_REPARSE_POINT,
                        buffer.as_ptr() as *const _,
                        bytes_returned,
                        null_mut(),
                        0,
                        &mut bytes_returned,
                        null_mut(),
                    );
                    
                    CloseHandle(dst_handle);
                }
            }
        }
        
        CloseHandle(src_handle);
        Ok(())
    }

    unsafe fn copy_compression_state(&self, src: *const u16, dst: *const u16) -> std::io::Result<()> {
        let src_handle = CreateFileW(src, GENERIC_READ, FILE_SHARE_READ, null(), OPEN_EXISTING, 0, 0);
        if src_handle == INVALID_HANDLE_VALUE {
            return Ok(());
        }
        
        let mut compression_state: u16 = 0;
        let mut bytes_returned = 0;
        
        let result = DeviceIoControl(
            src_handle,
            FSCTL_GET_COMPRESSION,
            null_mut(),
            0,
            &mut compression_state as *mut _ as *mut _,
            size_of::<u16>() as u32,
            &mut bytes_returned,
            null_mut(),
        );
        
        CloseHandle(src_handle);
        
        if result != 0 && compression_state != COMPRESSION_FORMAT_NONE {
            let dst_handle = CreateFileW(dst, GENERIC_WRITE, 0, null(), OPEN_EXISTING, 0, 0);
            if dst_handle != INVALID_HANDLE_VALUE {
                DeviceIoControl(
                    dst_handle,
                    FSCTL_SET_COMPRESSION,
                    &compression_state as *const _ as *const _,
                    size_of::<u16>() as u32,
                    null_mut(),
                    0,
                    &mut bytes_returned,
                    null_mut(),
                );
                
                CloseHandle(dst_handle);
            }
        }
        
        Ok(())
    }

    unsafe fn copy_encryption(&self, src: *const u16, dst: *const u16) -> std::io::Result<()> {
        // Check if source is encrypted
        let attrs = GetFileAttributesW(src);
        if attrs == INVALID_FILE_ATTRIBUTES || (attrs & FILE_ATTRIBUTE_ENCRYPTED) == 0 {
            return Ok(());
        }
        
        // Use raw encryption APIs
        let mut context = 0;
        let export_result = OpenEncryptedFileRawW(src, 0, &mut context);
        
        if export_result == 0 {
            // Read encrypted data
            let mut encrypted_data = Vec::new();
            
            extern "system" fn export_callback(
                pbdata: *const u8,
                cbdata: *mut std::ffi::c_void,
                ulength: u32,
            ) -> u32 {
                unsafe {
                    let data = cbdata as *mut Vec<u8>;
                    (*data).extend_from_slice(std::slice::from_raw_parts(pbdata, ulength as usize));
                    0 // ERROR_SUCCESS
                }
            }
            
            ReadEncryptedFileRaw(
                Some(export_callback),
                &mut encrypted_data as *mut _ as *mut _,
                context,
            );
            
            CloseEncryptedFileRaw(context);
            
            // Write encrypted data to destination
            let mut import_context = 0;
            let import_result = OpenEncryptedFileRawW(dst, CREATE_FOR_IMPORT, &mut import_context);
            
            if import_result == 0 {
                let mut data_ptr = encrypted_data.as_ptr();
                let mut remaining = encrypted_data.len();
                
                extern "system" fn import_callback(
                    pbdata: *mut u8,
                    cbdata: *mut std::ffi::c_void,
                    ulength: *mut u32,
                ) -> u32 {
                    unsafe {
                        let state = cbdata as *mut (*const u8, usize);
                        let available = (*state).1.min(*ulength as usize);
                        
                        if available > 0 {
                            std::ptr::copy_nonoverlapping((*state).0, pbdata, available);
                            (*state).0 = (*state).0.add(available);
                            (*state).1 -= available;
                            *ulength = available as u32;
                        } else {
                            *ulength = 0;
                        }
                        
                        0 // ERROR_SUCCESS
                    }
                }
                
                let mut state = (data_ptr, remaining);
                WriteEncryptedFileRaw(
                    Some(import_callback),
                    &mut state as *mut _ as *mut _,
                    import_context,
                );
                
                CloseEncryptedFileRaw(import_context);
            }
        }
        
        Ok(())
    }

    unsafe fn copy_object_id(&self, src: *const u16, dst: *const u16) -> std::io::Result<()> {
        let src_handle = CreateFileW(src, GENERIC_READ, FILE_SHARE_READ, null(), OPEN_EXISTING, 0, 0);
        if src_handle == INVALID_HANDLE_VALUE {
            return Ok(());
        }
        
        let mut object_id_buffer: FILE_OBJECTID_BUFFER = zeroed();
        let mut bytes_returned = 0;
        
        let result = DeviceIoControl(
            src_handle,
            FSCTL_GET_OBJECT_ID,
            null_mut(),
            0,
            &mut object_id_buffer as *mut _ as *mut _,
            size_of::<FILE_OBJECTID_BUFFER>() as u32,
            &mut bytes_returned,
            null_mut(),
        );
        
        CloseHandle(src_handle);
        
        if result != 0 {
            let dst_handle = CreateFileW(dst, GENERIC_WRITE, 0, null(), OPEN_EXISTING, 0, 0);
            if dst_handle != INVALID_HANDLE_VALUE {
                // Create or set object ID on destination
                DeviceIoControl(
                    dst_handle,
                    FSCTL_SET_OBJECT_ID,
                    &object_id_buffer as *const _ as *const _,
                    size_of::<FILE_OBJECTID_BUFFER>() as u32,
                    null_mut(),
                    0,
                    &mut bytes_returned,
                    null_mut(),
                );
                
                CloseHandle(dst_handle);
            }
        }
        
        Ok(())
    }

    unsafe fn copy_security(&self, src: *const u16, dst: *const u16) -> std::io::Result<()> {
        let security_info = OWNER_SECURITY_INFORMATION | 
                           GROUP_SECURITY_INFORMATION | 
                           DACL_SECURITY_INFORMATION | 
                           SACL_SECURITY_INFORMATION |
                           LABEL_SECURITY_INFORMATION |
                           ATTRIBUTE_SECURITY_INFORMATION |
                           SCOPE_SECURITY_INFORMATION |
                           BACKUP_SECURITY_INFORMATION;
        
        let mut sd_size = 0;
        GetFileSecurityW(
            src,
            security_info,
            null_mut(),
            0,
            &mut sd_size,
        );
        
        if sd_size > 0 {
            let mut sd_buffer = vec![0u8; sd_size as usize];
            
            let result = GetFileSecurityW(
                src,
                security_info,
                sd_buffer.as_mut_ptr() as *mut _,
                sd_size,
                &mut sd_size,
            );
            
            if result != 0 {
                SetFileSecurityW(
                    dst,
                    security_info,
                    sd_buffer.as_ptr() as *const _,
                );
            }
        }
        
        Ok(())
    }

    unsafe fn copy_timestamps(&self, src: *const u16, dst: *const u16) -> std::io::Result<()> {
        let src_handle = CreateFileW(
            src,
            GENERIC_READ,
            FILE_SHARE_READ,
            null(),
            OPEN_EXISTING,
            FILE_FLAG_BACKUP_SEMANTICS,
            0,
        );
        
        if src_handle == INVALID_HANDLE_VALUE {
            return Ok(());
        }
        
        let mut creation_time = FILETIME { dwLowDateTime: 0, dwHighDateTime: 0 };
        let mut access_time = FILETIME { dwLowDateTime: 0, dwHighDateTime: 0 };
        let mut write_time = FILETIME { dwLowDateTime: 0, dwHighDateTime: 0 };
        
        GetFileTime(src_handle, &mut creation_time, &mut access_time, &mut write_time);
        CloseHandle(src_handle);
        
        let dst_handle = CreateFileW(
            dst,
            GENERIC_WRITE,
            0,
            null(),
            OPEN_EXISTING,
            FILE_FLAG_BACKUP_SEMANTICS,
            0,
        );
        
        if dst_handle != INVALID_HANDLE_VALUE {
            SetFileTime(dst_handle, &creation_time, &access_time, &write_time);
            CloseHandle(dst_handle);
        }
        
        Ok(())
    }

    unsafe fn copy_attributes(&self, src: *const u16, dst: *const u16) -> std::io::Result<()> {
        let attrs = GetFileAttributesW(src);
        if attrs != INVALID_FILE_ATTRIBUTES {
            SetFileAttributesW(dst, attrs);
        }
        Ok(())
    }

    fn enable_privileges(&self) -> std::io::Result<()> {
        unsafe {
            let mut token = 0;
            let process = GetCurrentProcess();
            
            if OpenProcessToken(
                process,
                TOKEN_ADJUST_PRIVILEGES | TOKEN_QUERY,
                &mut token,
            ) == 0 {
                return Err(std::io::Error::last_os_error());
            }
            
            // Enable all backup/restore privileges
            let privileges = [
                w!("SeBackupPrivilege"),
                w!("SeRestorePrivilege"),
                w!("SeSecurityPrivilege"),
                w!("SeTakeOwnershipPrivilege"),
                w!("SeChangeNotifyPrivilege"),
            ];
            
            for privilege_name in privileges {
                let mut luid = LUID { LowPart: 0, HighPart: 0 };
                if LookupPrivilegeValueW(null(), privilege_name, &mut luid) != 0 {
                    let mut tp = TOKEN_PRIVILEGES {
                        PrivilegeCount: 1,
                        Privileges: [LUID_AND_ATTRIBUTES {
                            Luid: luid,
                            Attributes: SE_PRIVILEGE_ENABLED,
                        }; 1],
                    };
                    
                    AdjustTokenPrivileges(
                        token,
                        FALSE,
                        &tp,
                        0,
                        null_mut(),
                        null_mut(),
                    );
                }
            }
            
            CloseHandle(token);
            Ok(())
        }
    }
}

// Constants for copy flags
const COPY_ALL: u32 = 0xFFFFFFFF;
const COMPRESSION_FORMAT_NONE: u16 = 0;
const MAXIMUM_REPARSE_DATA_BUFFER_SIZE: u32 = 16 * 1024;
const CREATE_FOR_IMPORT: u32 = 1;

// Additional structures if not in windows-sys
#[repr(C)]
struct FILE_ALLOCATED_RANGE_BUFFER {
    FileOffset: i64,
    Length: i64,
}

#[repr(C)]
struct FILE_OBJECTID_BUFFER {
    ObjectId: [u8; 16],
    BirthVolumeId: [u8; 16],
    BirthObjectId: [u8; 16],
    DomainId: [u8; 16],
}

// Usage
pub fn copy_file_like_robocopy(src: &Path, dst: &Path) -> std::io::Result<()> {
    let copier = RobustCopy::new();
    copier.copy_file(src, dst)
}